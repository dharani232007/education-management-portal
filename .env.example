# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/education_management_portal

# --- Backend / Auth (Person 2 wires these up) ---
JWT_SECRET=replace-with-a-long-random-string
PORT=5000

# --- AI Academic Intelligence (optional) ---
# If AI_API_KEY is left blank, the app automatically uses the built-in
# rule-based fallback engine (backend/services/fallbackAI.js) and keeps working.
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=8000
